{
  "name": "express-drizzle-postgres-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=30",
    "check:lint": "turbo run check:lint",
    "fix:lint": "turbo run fix:lint",
    "check:types": "turbo run check:types",
    "format": "prettier --write \"**/*.{ts,tsx,json,css}\"",
    "gen:docs": "typedoc",
    "gen:docs-all": "npm run docs --workspaces --if-present",
    "clean": "turbo run clean && rm -rf node_modules dist .turbo && echo 'Root Cleanup complete!'",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "globals": "^17.11.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@commitlint/prompt-cli": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "commitlint-plugin-tense": "^1.0.10",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.13"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "zod": "^4.4.3",
    "tsdown": "^0.22.14"
  },
  "engines": {
    "node": ">=24"
  }
}
